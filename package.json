		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"@fontsource-variable/oxanium": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"@ui-sdk/core": "^0.1.0-beta.6",
		"@ui-sdk/svelte": "^0.1.0-beta.6"
	}
